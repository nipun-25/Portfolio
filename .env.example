# ==============================================================================
# RESEND EMAIL CONFIGURATION
# ==============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address configured in Resend.
# If you don't have a verified custom domain, use Resend's default test sender:
# "Portfolio Contact <onboarding@resend.dev>"
# Note: onboarding@resend.dev delivers directly to the email registered on your Resend account.
# Once you add and verify a custom domain in Resend, change this to:
# "Nipun Kulshrestha <contact@yourdomain.com>"
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Destination email inbox where contact form submissions will be delivered
CONTACT_RECEIVER_EMAIL=nipunkulshrestha25@gmail.com
